{
  "current_offering_id": "eligibility_lab",
  "gallery": {
    "sources": [
      "https://github.com/RevenueCat/purchases-ios/blob/d654b8b85143c29e5bb73d0ff92f5f5766fbbedc/Tests/RevenueCatUITests/PaywallsV2/PresentedPartialsTests.swift"
    ],
    "packages": [
      { "identifier": "$rc_annual", "store_product": {
        "identifier": "gallery.annual", "title": "Annual Pro", "price_string": "$49.99",
        "subscription_period": { "value": 1, "unit": "year" },
        "introductory_discount": { "price_string": "$0.00", "number_of_periods": 1, "subscription_period": { "value": 1, "unit": "week" } }
      } }
    ],
    "variants": [
      { "name": "Unknown", "expected_outcome": "No trial promise. Annual Pro is still purchasable for $49.99.",
        "expected_text": { "offer-message": "Annual access. Trial eligibility has not been confirmed.", "purchase-copy": "Continue for $49.99" },
        "expected_visible": { "trial-detail": false }, "expected_purchase_package": "$rc_annual" },
      { "name": "Eligible", "intro_eligibility": { "gallery.annual": "Eligible" },
        "expected_outcome": "One week for $0.00 appears; the purchase still targets Annual Pro.",
        "expected_text": { "offer-message": "Your introductory offer is available.", "trial-detail": "Try for week at $0.00, then $49.99 / year." },
        "expected_visible": { "trial-detail": true }, "expected_purchase_package": "$rc_annual" },
      { "name": "Ineligible", "intro_eligibility": { "gallery.annual": "Ineligible" },
        "expected_outcome": "Regular-price copy replaces trial copy. The plan remains available.",
        "expected_text": { "offer-message": "Annual access at the regular price." },
        "expected_visible": { "trial-detail": false }, "expected_purchase_package": "$rc_annual" },
      { "name": "No introductory offer", "intro_eligibility": { "gallery.annual": "NoIntroOfferExists" },
        "expected_outcome": "No trial copy; continue at the regular price.",
        "expected_text": { "offer-message": "Annual access at the regular price." },
        "expected_visible": { "trial-detail": false }, "expected_purchase_package": "$rc_annual" }
    ]
  },
  "offerings": [{
    "identifier": "eligibility_lab",
    "packages": [{ "identifier": "$rc_annual", "platform_product_identifier": "gallery.annual" }],
    "paywall_components": {
      "id": "verified-eligibility", "default_locale": "en_US",
      "components_config": { "base": {
        "background": { "light": { "type": "hex", "value": "#eefaf5ff" } },
        "stack": { "type": "stack", "spacing": 18, "padding": { "top": 24, "bottom": 24, "leading": 20, "trailing": 20 }, "components": [
          { "type": "text", "id": "title", "text_lid": "title", "font_size": "heading_l", "font_weight": "bold", "color": { "light": { "type": "hex", "value": "#124d39ff" } } },
          { "type": "text", "id": "offer-message", "text_lid": "unknown", "font_size": "body_l",
            "overrides": [
              { "conditions": [{ "type": "intro_offer_condition", "operator": "=", "value": false }], "properties": { "text_lid": "regular" } },
              { "conditions": [{ "type": "intro_offer_condition", "operator": "=", "value": true }], "properties": { "text_lid": "eligible" } }
            ] },
          { "type": "package", "id": "annual", "package_id": "$rc_annual", "is_selected_by_default": true,
            "stack": { "type": "stack", "spacing": 12, "padding": { "top": 20, "bottom": 20, "leading": 18, "trailing": 18 },
              "shape": { "type": "rectangle", "corners": { "all": 22 } }, "background_color": { "light": { "type": "hex", "value": "#ffffffff" } },
              "components": [
                { "type": "text", "id": "plan-name", "text_lid": "plan", "font_size": "heading_s", "font_weight": "bold" },
                { "type": "text", "id": "trial-detail", "text_lid": "trial", "visible": false, "font_size": "body_m",
                  "overrides": [{ "conditions": [{ "type": "intro_offer" }], "properties": { "visible": true } }] }
              ] }
          },
          { "type": "text", "text_lid": "note", "font_size": "body_s" }
        ] },
        "sticky_footer": { "type": "sticky_footer", "stack": { "type": "stack",
          "padding": { "top": 12, "bottom": 18, "leading": 20, "trailing": 20 }, "components": [
            { "type": "purchase_button", "id": "purchase", "stack": { "type": "stack", "shape": { "type": "pill" },
              "padding": { "top": 15, "bottom": 15, "leading": 16, "trailing": 16 },
              "background_color": { "light": { "type": "hex", "value": "#176448ff" } }, "components": [
                { "type": "text", "id": "purchase-copy", "text_lid": "cta", "font_weight": "bold", "color": { "light": { "type": "hex", "value": "#ffffffff" } } }
              ] } }
          ] } }
      } },
      "components_localizations": { "en_US": {
        "title": "An offer, only when eligible",
        "unknown": "Annual access. Trial eligibility has not been confirmed.",
        "regular": "Annual access at the regular price.",
        "eligible": "Your introductory offer is available.",
        "plan": "{{ product_name }} - {{ price }}",
        "trial": "Try for {{ sub_offer_duration }} at {{ sub_offer_price }}, then {{ price }} / {{ sub_period }}.",
        "note": "Demo inputs only. This gallery never checks a real customer's eligibility or charges a store account.",
        "cta": "Continue for {{ price }}"
      } }
    }
  }]
}
