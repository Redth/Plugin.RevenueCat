{
  "current_offering_id": "audience_lab",
  "gallery": {
    "sources": [
      "https://github.com/RevenueCat/purchases-ios/blob/d654b8b85143c29e5bb73d0ff92f5f5766fbbedc/Tests/RevenueCatUITests/PaywallsV2/PresentedPartialsTests.swift"
    ],
    "variants": [
      { "name": "Standard audience", "variables": { "vip": false }, "expected_outcome": "Standard access. Annual selection alone does not activate the VIP rule.",
        "expected_text": { "audience-message": "Standard access" }, "expected_purchase_package": "$rc_monthly" },
      { "name": "VIP audience", "variables": { "vip": true }, "expected_outcome": "VIP access; select Annual to see the later AND rule win.",
        "expected_text": { "audience-message": "VIP access" }, "expected_purchase_package": "$rc_monthly" },
      { "name": "Wrong type: string true", "variables": { "vip": "true" }, "expected_outcome": "A string is not boolean true: standard access remains.",
        "expected_text": { "audience-message": "Standard access" }, "expected_purchase_package": "$rc_monthly" }
    ]
  },
  "offerings": [{
    "identifier": "audience_lab",
    "packages": [
      { "identifier": "$rc_monthly", "platform_product_identifier": "gallery.monthly" },
      { "identifier": "$rc_annual", "platform_product_identifier": "gallery.annual" }
    ],
    "paywall_components": {
      "id": "verified-rules", "default_locale": "en_US",
      "components_config": { "base": {
        "background": { "light": { "type": "hex", "value": "#f2efffff" } },
        "stack": { "type": "stack", "spacing": 16, "padding": { "top": 24, "bottom": 20, "leading": 20, "trailing": 20 }, "components": [
          { "type": "text", "text_lid": "title", "font_size": "heading_l", "font_weight": "bold", "color": { "light": { "type": "hex", "value": "#382066ff" } } },
          { "type": "text", "id": "audience-message", "text_lid": "standard", "font_size": "heading_s",
            "overrides": [
              { "conditions": [{ "type": "variable_condition", "variable": "vip", "operator": "=", "value": true }], "properties": { "text_lid": "vip", "font_weight": "bold" } },
              { "conditions": [{ "type": "variable_condition", "variable": "vip", "operator": "=", "value": true }, { "type": "selected_package_condition", "operator": "in", "packages": ["$rc_annual"] }],
                "properties": { "text_lid": "vip_annual", "color": { "light": { "type": "hex", "value": "#642ba3ff" } } } }
            ] },
          { "type": "package", "id": "monthly", "package_id": "$rc_monthly", "is_selected_by_default": true,
            "stack": { "type": "stack", "shape": { "type": "pill" }, "padding": { "top": 18, "bottom": 18, "leading": 14, "trailing": 14 },
              "background_color": { "light": { "type": "hex", "value": "#ffffffff" } }, "components": [
                { "type": "text", "id": "monthly-price", "text_lid": "plan", "font_size": "body_l" }
              ] } },
          { "type": "package", "id": "annual", "package_id": "$rc_annual",
            "stack": { "type": "stack", "shape": { "type": "pill" }, "padding": { "top": 18, "bottom": 18, "leading": 14, "trailing": 14 },
              "background_color": { "light": { "type": "hex", "value": "#ffffffff" } }, "components": [
                { "type": "text", "id": "annual-price", "text_lid": "plan", "font_size": "body_l" }
              ] } },
          { "type": "text", "text_lid": "note", "font_size": "body_m" }
        ] },
        "sticky_footer": { "type": "footer", "stack": { "type": "stack", "padding": { "top": 12, "bottom": 18, "leading": 20, "trailing": 20 }, "components": [
          { "type": "purchase_button", "id": "purchase", "stack": { "type": "stack", "shape": { "type": "pill" },
            "padding": { "top": 15, "bottom": 15, "leading": 16, "trailing": 16 }, "background_color": { "light": { "type": "hex", "value": "#582a8aff" } },
            "components": [{ "type": "text", "id": "purchase-copy", "text_lid": "cta", "font_weight": "bold", "color": { "light": { "type": "hex", "value": "#ffffffff" } } }] } }
        ] } }
      } },
      "components_localizations": { "en_US": {
        "title": "The right message",
        "standard": "Standard access", "vip": "VIP access", "vip_annual": "VIP annual access",
        "plan": "{{ product_name }} - {{ price }}", "cta": "Continue for {{ price }}",
        "note": "Both audience and package must match. These are copy changes, not price discounts."
      } }
    }
  }]
}
