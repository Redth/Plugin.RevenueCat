{
  "current_offering_id": "mixed_lab",
  "gallery": {
    "sources": [
      "https://github.com/RevenueCat/purchases-ios/blob/d654b8b85143c29e5bb73d0ff92f5f5766fbbedc/Tests/RevenueCatUITests/PaywallsV2/MixedTabsDefaultPackageVisibilityTests.swift"
    ],
    "variants": [
      { "name": "Hidden default", "variables": { "show_annual": false },
        "expected_outcome": "Monthly is selected. Open Weekly, then return to Details: the hidden Annual must not return.",
        "expected_visible": { "annual": false }, "expected_text": { "purchase-copy": "Continue for $6.99" }, "expected_purchase_package": "$rc_monthly" },
      { "name": "Annual visible", "variables": { "show_annual": true },
        "expected_outcome": "Annual can be selected. Hide it again to reconcile to a visible available plan.",
        "expected_visible": { "annual": true }, "expected_purchase_package": "$rc_annual" },
      { "name": "Annual removed from catalog", "variables": { "show_annual": true }, "available_packages": ["$rc_monthly", "$rc_weekly"],
        "expected_outcome": "Annual is visible but disabled; it cannot become the purchase target.",
        "expected_visible": { "annual": true }, "expected_purchase_package": "$rc_monthly" }
    ]
  },
  "offerings": [{
    "identifier": "mixed_lab",
    "packages": [
      { "identifier": "$rc_annual", "platform_product_identifier": "gallery.annual" },
      { "identifier": "$rc_monthly", "platform_product_identifier": "gallery.monthly" },
      { "identifier": "$rc_weekly", "platform_product_identifier": "gallery.weekly" }
    ],
    "paywall_components": {
      "id": "verified-mixed", "default_locale": "en_US",
      "components_config": { "base": {
        "background": { "light": { "type": "hex", "value": "#fff4eaff" } },
        "stack": { "type": "stack", "spacing": 14, "padding": { "top": 22, "bottom": 20, "leading": 18, "trailing": 18 }, "components": [
          { "type": "text", "text_lid": "title", "font_size": "heading_l", "font_weight": "bold", "color": { "light": { "type": "hex", "value": "#663610ff" } } },
          { "type": "package", "id": "annual", "package_id": "$rc_annual", "is_selected_by_default": true,
            "stack": { "type": "stack", "visible": false, "shape": { "type": "pill" }, "padding": { "top": 14, "bottom": 14, "leading": 12, "trailing": 12 },
              "background_color": { "light": { "type": "hex", "value": "#ffffffff" } },
              "overrides": [{ "conditions": [{ "type": "variable_condition", "variable": "show_annual", "operator": "=", "value": true }], "properties": { "visible": true } }],
              "components": [{ "type": "text", "text_lid": "plan", "font_size": "body_l" }] } },
          { "type": "package", "id": "monthly", "package_id": "$rc_monthly",
            "stack": { "type": "stack", "shape": { "type": "pill" }, "padding": { "top": 14, "bottom": 14, "leading": 12, "trailing": 12 },
              "background_color": { "light": { "type": "hex", "value": "#ffffffff" } }, "components": [{ "type": "text", "text_lid": "plan", "font_size": "body_l" }] } },
          { "type": "tabs", "id": "options", "default_tab_id": "details",
            "control": { "type": "buttons", "stack": { "type": "stack", "dimension": { "type": "horizontal", "distribution": "center" }, "spacing": 8, "components": [
              { "type": "tab_control_button", "id": "details-tab", "tab_id": "details", "stack": { "type": "stack", "shape": { "type": "pill" }, "padding": { "top": 8, "bottom": 8, "leading": 14, "trailing": 14 }, "components": [{ "type": "text", "text_lid": "details" }] } },
              { "type": "tab_control_button", "id": "weekly-tab", "tab_id": "weekly", "stack": { "type": "stack", "shape": { "type": "pill" }, "padding": { "top": 8, "bottom": 8, "leading": 14, "trailing": 14 }, "components": [{ "type": "text", "text_lid": "weekly" }] } }
            ] } },
            "tabs": [
              { "id": "details", "name": "Details", "stack": { "type": "stack", "components": [
                { "type": "text", "text_lid": "details_copy", "font_size": "body_m" }
              ] } },
              { "id": "weekly", "name": "Weekly", "stack": { "type": "stack", "components": [
                { "type": "package", "id": "weekly-package", "package_id": "$rc_weekly", "stack": { "type": "stack", "shape": { "type": "pill" }, "padding": { "top": 14, "bottom": 14, "leading": 12, "trailing": 12 }, "background_color": { "light": { "type": "hex", "value": "#ffffffff" } }, "components": [{ "type": "text", "text_lid": "plan", "font_size": "body_l" }] } }
              ] } }
            ] }
        ] },
        "sticky_footer": { "type": "footer", "stack": { "type": "stack", "padding": { "top": 12, "bottom": 18, "leading": 20, "trailing": 20 }, "components": [
          { "type": "purchase_button", "id": "purchase", "stack": { "type": "stack", "shape": { "type": "pill" }, "padding": { "top": 15, "bottom": 15, "leading": 16, "trailing": 16 }, "background_color": { "light": { "type": "hex", "value": "#874517ff" } }, "components": [
            { "type": "text", "id": "purchase-copy", "text_lid": "cta", "font_weight": "bold", "color": { "light": { "type": "hex", "value": "#ffffffff" } } }
          ] } }
        ] } }
      } },
      "components_localizations": { "en_US": {
        "title": "Only visible plans count", "details": "Details", "weekly": "Weekly",
        "details_copy": "This tab has no package. Its purchase button uses an available plan above.",
        "plan": "{{ product_name }} - {{ price }}", "cta": "Continue for {{ price }}"
      } }
    }
  }]
}
