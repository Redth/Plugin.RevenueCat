<Project Sdk="MSTest.Sdk/4.4.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<NoPack>True</NoPack>
    <UseVSTest>true</UseVSTest>
    <UserSecretsId>051994aa-dd59-49e7-924d-26ce21e70087</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin.RevenueCat.Api\Plugin.RevenueCat.Api.csproj" />
    <ProjectReference Include="..\Plugin.RevenueCat.Core\Plugin.RevenueCat.Core.csproj" />
    <ProjectReference Include="..\Plugin.RevenueCat\Plugin.RevenueCat.csproj" />
    <ProjectReference Include="..\Plugin.RevenueCat.Paywalls\Plugin.RevenueCat.Paywalls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exercise the shipping renderer's managed view tree without native handlers. -->
    <Compile Include="../Plugin.RevenueCat.Paywalls/Controls/**/*.cs" Link="Paywalls/Controls/%(Filename)%(Extension)" />
    <Compile Include="../Plugin.RevenueCat.Paywalls/Rendering/Maui/**/*.cs" Link="Paywalls/Rendering/%(Filename)%(Extension)" />
    <None Include="../sample-paywalls/Resources/Raw/paywalls/*.json" Link="paywalls/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
